{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.moviespk.local/common.json",
  "title": "Common definitions",
  "$defs": {
    "UtcDateTime": {
      "description": "ISO 8601 UTC timestamp with a literal Z (JavaScript toISOString form).",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "Date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "Slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "ObjectIdHex": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
    "Url": { "type": "string", "pattern": "^https?://", "maxLength": 2048 },
    "Latitude": { "type": "number", "minimum": 23.6, "maximum": 37.1 },
    "Longitude": { "type": "number", "minimum": 60.8, "maximum": 77.9 },
    "LatLng": {
      "description": "API location format. MongoDB stores GeoJSON instead (plan §9.1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lng"],
      "properties": {
        "lat": { "$ref": "#/$defs/Latitude" },
        "lng": { "$ref": "#/$defs/Longitude" }
      }
    },
    "GeoPoint": {
      "description": "Stored GeoJSON Point; coordinates are [lng, lat] inside Pakistan's bounding box.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Point" },
        "coordinates": {
          "type": "array",
          "prefixItems": [{ "$ref": "#/$defs/Longitude" }, { "$ref": "#/$defs/Latitude" }],
          "items": false,
          "minItems": 2
        }
      }
    },
    "Genre": {
      "enum": [
        "action",
        "adventure",
        "animation",
        "comedy",
        "crime",
        "documentary",
        "drama",
        "family",
        "fantasy",
        "history",
        "horror",
        "music",
        "mystery",
        "romance",
        "science-fiction",
        "thriller",
        "war",
        "western",
        "other"
      ]
    },
    "Language": { "enum": ["ur", "en", "pa", "hi", "ps", "sd", "other"] },
    "Format": { "enum": ["2D", "3D", "IMAX", "4DX", "OTHER"] },
    "PosterKey": { "type": "string", "pattern": "^movies/[0-9a-f]{24}/poster-[0-9a-f]{8}$" },
    "CinemaHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["ok", "partial", "failed", "blocked", "drift", "unknown"] },
        "lastSuccessAt": { "$ref": "#/$defs/UtcDateTime" },
        "lastRunAt": { "$ref": "#/$defs/UtcDateTime" }
      }
    }
  }
}
