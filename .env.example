# Names only (plan §6.3). Never commit values. Copy to .env for local dev.

# --- Scraper (GitHub environments `production` / `dev`) ---
MONGODB_URI_SCRAPER=mongodb://localhost:27017
MONGODB_DB=moviespk_dev
TMDB_API_KEY=
SCRAPER_USER_AGENT="MoviesPKBot/1.0 (+<repo URL>; <project email>)"
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=moviespk-dev

# --- API (Vercel project moviespk-api) ---
MONGODB_URI_API=mongodb://localhost:27017
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# --- Web (Vercel project moviespk-web) ---
API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_IMAGE_BASE=
NEXT_PUBLIC_IMAGES_ENABLED=false
